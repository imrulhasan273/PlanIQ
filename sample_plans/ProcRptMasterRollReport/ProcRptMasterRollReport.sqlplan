<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4265.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="--exec [report].[ProcRptMasterRollReport] -1,3486,-1,-1,-1,-1,20260101000000,20260505000000&#x0D;&#x0A;-- =============================================&#x0D;&#x0A;-- Author: Subarata Talukder&#x0D;&#x0A;-- Last Updated by: Md Mukitul Islam&#x0D;&#x0A;-- Updated: 05/04/2026&#x0D;&#x0A;-- Description:&#x09;LiTE Version 10:V12&#x0D;&#x0A;-- AMMSW-9062&#x0D;&#x0A;-- =============================================&#x0D;&#x0A;CREATE PROCEDURE [report].[ProcRptMasterRollReport] (&#x0D;&#x0A;&#x09;@loanType INT&#x0D;&#x0A;&#x09;,@branchIds NVARCHAR(max)&#x0D;&#x0A;&#x09;,@loanOfficer INT&#x0D;&#x0A;&#x09;,@groupId INT&#x0D;&#x0A;&#x09;,@memberId INT&#x0D;&#x0A;&#x09;,@meetingDayId INT&#x0D;&#x0A;&#x09;,@startDate BIGINT&#x0D;&#x0A;&#x09;,@endDate BIGINT&#x0D;&#x0A;&#x09;)&#x0D;&#x0A;AS&#x0D;&#x0A;BEGIN&#x0D;&#x0A;&#x09;DECLARE @branchId INT=CAST(@branchIds AS INT);&#x0D;&#x0A;&#x09;-- ========================== Find loan accounts ==================================&#x0D;&#x0A;&#x09;" StatementId="1" StatementCompId="3" StatementType="ASSIGN" RetrievedFromCache="true"/><StmtSimple StatementText="SELECT DISTINCT LA.[Id],LA.[MemberId],LA.[ProductId],LA.[CurrentBranchId],LA.[GroupId],LA.[LoanOfficerId],&#x0D;&#x0A;&#x09;&#x09;LA.[FundId],LA.[SubCodeId],LA.[Duration],LA.[DisburseAmount],&#x0D;&#x0A;&#x09;&#x09;CASE WHEN &#x0D;&#x0A;&#x09;&#x09;&#x09;TRA.TransferId = 'TRF-MigrationAdmin' THEN TRA.ReceivingBranchId ELSE LA.[OriginatingBranchId] &#x0D;&#x0A;&#x09;&#x09;END AS OriginatingBranchId,LA.[DisburseDate],LA.[GracePeriod],LA.[InstallmentFrequencyId],&#x0D;&#x0A;&#x09;&#x09;LA.[FirstInstallmentDate],LA.[IsSupplimentary],LA.[LoanCycle],LA.[SchemeId],LA.[PrincipalAmount],&#x0D;&#x0A;&#x09;&#x09;LA.[Status],LA.[ClosingDate],LA.[IsPrimary]&#x0D;&#x0A;&#x09;INTO #TMP_LOAN_ACC&#x0D;&#x0A;&#x09;FROM program.LoanAccount AS LA WITH (NOLOCK)&#x0D;&#x0A;&#x09;LEFT JOIN &#x0D;&#x0A;&#x09;&#x09;program.TransferReceiveAccount AS TRA WITH (NOLOCK)&#x0D;&#x0A;&#x09;&#x09;ON TRA.TransferredAccountId = LA.Id &#x0D;&#x0A;&#x09;&#x09;AND TRA.TransferredMemberId = LA.MemberId &#x0D;&#x0A;&#x09;&#x09;AND TRA.TransferStatus = 2&#x0D;&#x0A;&#x09;WHERE &#x0D;&#x0A;&#x09;&#x09;OriginatingBranchId = @branchId &#x0D;&#x0A;&#x09;&#x09;AND LA.DisburseDate &gt;= @startDate &#x0D;&#x0A;&#x09;&#x09;AND LA.DisburseDate &lt;= @endDate &#x0D;&#x0A;&#x09;&#x09;AND LA.[Status] &lt;&gt; -1&#x0D;&#x0A;&#x09;ORDER BY DisburseDate" StatementId="2" StatementCompId="4" StatementType="SELECT INTO" StatementSqlHandle="0x090054593938BFDA8C795D721191A2D5054F0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1068582895" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="26.2905" StatementEstRows="1.00111" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x51BE08B3AF9B95CE" QueryPlanHash="0xB4B7AF9DDCFBC6B8" CardinalityEstimationModelVersion="70"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan NonParallelPlanReason="MaxDOPSetToOne" CachedPlanSize="560" CompileTime="240" CompileCPU="240" CompileMemory="18336"><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT_IMPLICIT(int,[LA].[Status],0)"/><PlanAffectingConvert ConvertIssue="Seek Plan" Expression="CONVERT_IMPLICIT(int,[LA].[Status],0)&lt;(-1)"/></Warnings><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="2216" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="1887436" EstimatedPagesCached="7549747" EstimatedAvailableDegreeOfParallelism="1" MaxCompileMemory="788871944"/><TraceFlags IsCompileTime="1"><TraceFlag Value="3895