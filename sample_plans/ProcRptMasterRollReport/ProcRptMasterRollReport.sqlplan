teRebinds="0.22672" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="Code"/><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="Name"/></OutputList><IndexScan Lookup="1" Ordered="1" ScanDirection="FORWARD" ForcedIndex="0" ForceSeek="0" ForceScan="0" NoExpandHint="0" Storage="RowStore"><DefinedValues><DefinedValue><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="Code"/></DefinedValue><DefinedValue><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="Name"/></DefinedValue></DefinedValues><Object Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Index="[IX_Employee_partitioncol]" Alias="[EMP]" TableReferenceId="-1" IndexKind="Clustered" Storage="RowStore"/><SeekPredicates><SeekPredicateNew><SeekKeys><Prefix ScanType="EQ"><RangeColumns><ColumnReference Column="PtnId1024"/><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="CurrentBranchId"/><ColumnReference Column="Uniq1026"/></RangeColumns><RangeExpressions><ScalarOperator ScalarString="[PtnId1024]"><Identifier><ColumnReference Column="PtnId1024" ComputedColumn="1"/></Identifier></ScalarOperator><ScalarOperator ScalarString="[AmmsOnlineProd].[hrm].[Employee].[CurrentBranchId] as [EMP].[CurrentBranchId]"><Identifier><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="CurrentBranchId"/></Identifier></ScalarOperator><ScalarOperator ScalarString="[Uniq1026]"><Identifier><ColumnReference Column="Uniq1026"/></Identifier></ScalarOperator></RangeExpressions></Prefix></SeekKeys></SeekPredicateNew></SeekPredicates></IndexScan></RelOp></NestedLoops></RelOp></ComputeScalar></RelOp><Predicate><ScalarOperator ScalarString="[@loanOfficer]=(-1) OR [AmmsOnlineProd].[hrm].[Employee].[Id] as [EMP].[Id]=[@loanOfficer]"><Logical Operation="OR"><ScalarOperator><Identifier><ColumnReference Column="ConstExpr1047"><ScalarOperator><Compare CompareOp="EQ"><ScalarOperator><Identifier><ColumnReference Column="@loanOfficer"/></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="(-1)"/></ScalarOperator></Compare></ScalarOperator></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Compare CompareOp="EQ"><ScalarOperator><Identifier><ColumnReference Database="[AmmsOnlineProd]" Schema="[hrm]" Table="[Employee]" Alias="[EMP]" Column="Id"/></Identifier></ScalarOperator><ScalarOperator><Identifier><ColumnReference Column="@loanOfficer"/></Identifier></ScalarOperator></Compare></ScalarOperator></Logical></ScalarOperator></Predicate></Filter></RelOp><RelOp NodeId="72" PhysicalOp="Table Scan" LogicalOp="Table Scan" EstimateRows="126" EstimatedRowsRead="126" EstimateIO="0.00394424" EstimateCPU="0.0002171" AvgRowSize="35" EstimatedTotalSubtreeCost="0.00421056" TableCardinality="126" Parallel="0" EstimateRebinds="0" EstimateRewinds="0.22672" EstimatedExecutionMode="Row"><OutputList><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="Debit"/><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="Credit"/><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="AccountId"/></OutputList><TableScan Ordered="0" ForcedIndex="0" ForceScan="0" NoExpandHint="0" Storage="RowStore"><DefinedValues><DefinedValue><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="Debit"/></DefinedValue><DefinedValue><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="Credit"/></DefinedValue><DefinedValue><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="AccountId"/></DefinedValue></DefinedValues><Object Database="[tempdb]" Schema="[dbo]" Table="[#TMP_OTHER]" Alias="[tmpOth]" Storage="RowStore"/><Predicate><ScalarOperator ScalarString="#TMP_OTHER.[TransactionTypeId] as [tmpOth].[TransactionTypeId]=(47)"><Compare CompareOp="EQ"><ScalarOperator><Identifier><ColumnReference Table="#TMP_OTHER" Alias="[tmpOth]" Column="TransactionTypeId"/></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="(47)"/></ScalarOperator></Compare></ScalarOperator></Predicate></TableScan></RelOp></NestedLoops></RelOp></ComputeScalar></RelOp><RelOp NodeId="73" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1" EstimateIO="0" EstimateCPU="1e-07" AvgRowSize="36" EstimatedTotalSubtreeCost="0.00335861" Parallel="0" EstimateRebinds="0.22672" EstimateRewinds="8.75443e-08" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1035"/></OutputList><ComputeScalar><DefinedValues><DefinedValue><ColumnReference Column="Expr1035"/><ScalarOperator ScalarString="[AmmsOnlineProd].[program].[FeeConfig].[Name]"><Identifier><ColumnReference Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeConfig]" Column="Name"/></Identifier></ScalarOperator></DefinedValue></DefinedValues><RelOp NodeId="74" PhysicalOp="Clustered Index Scan" LogicalOp="Clustered Index Scan" EstimateRows="1" EstimatedRowsRead="23" EstimateIO="0.0032035" EstimateCPU="0.0001038" AvgRowSize="43" EstimatedTotalSubtreeCost="0.00333083" TableCardinality="23" Parallel="0" EstimateRebinds="0" EstimateRewinds="0.22672" EstimatedExecutionMode="Row"><OutputList><ColumnReference Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeConfig]" Column="Name"/></OutputList><IndexScan Ordered="0" ForcedIndex="0" ForceScan="0" NoExpandHint="0" Storage="RowStore"><DefinedValues><DefinedValue><ColumnReference Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeConfig]" Column="Name"/></DefinedValue></DefinedValues><Object Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeConfig]" Index="[PK_FeeConfig]" IndexKind="Clustered" Storage="RowStore"/><Predicate><ScalarOperator ScalarString="[AmmsOnlineProd].[program].[FeeConfig].[Type]='PolicyType' AND CONVERT_IMPLICIT(int,[AmmsOnlineProd].[program].[FeeConfig].[Value],0)=[AmmsOnlineProd].[program].[FeeLoanAccountWithDetails].[PolicyId] as [fl].[PolicyId]"><Logical Operation="AND"><ScalarOperator><Compare CompareOp="EQ"><ScalarOperator><Identifier><ColumnReference Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeConfig]" Column="Type"/></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="'PolicyType'"/></ScalarOperator></Compare></ScalarOperator><ScalarOperator><Compare CompareOp="EQ"><ScalarOperator><Convert DataType="int" Style="0" Implicit="1"><ScalarOperator><Identifier><ColumnReference Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeConfig]" Column="Value"/></Identifier></ScalarOperator></Convert></ScalarOperator><ScalarOperator><Identifier><ColumnReference Database="[AmmsOnlineProd]" Schema="[program]" Table="[FeeLoanAccountWithDetails]" Alias="[fl]" Column="PolicyId"/></Identifier></ScalarOperator></Compare></ScalarOperator></Logical></ScalarOperator></Predicate></IndexScan></RelOp></ComputeScalar></RelOp></NestedLoops></RelOp></ComputeScalar></RelOp></Hash></RelOp></Update></RelOp><ParameterList><ColumnReference Column="@meetingDayId" ParameterDataType="int" ParameterCompiledValue="(-1)"/><ColumnReference Column="@groupId" ParameterDataType="int" ParameterCompiledValue="(-1)"/><ColumnReference Column="@loanOfficer" ParameterDataType="int" ParameterCompiledValue="(-1)"/><ColumnReference Column="@loanType" ParameterDataType="int" ParameterCompiledValue="(-1)"/></ParameterList></QueryPlan></StmtSimple></Statements></Then><Else><Statements><StmtSimple StatementText="&#x0D;&#x0A;&#x09;&#x09;END&#x0D;&#x0A;&#x09;ELSE&#x0D;&#x0A;&#x09;&#x09;BEGIN&#x0D;&#x0A;&#x09;&#x09;&#x09;SELECT DISTINCT &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;z.[Name] AS DivisionName_string,&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;d.[Name] AS DistrictName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,r.[Name] AS RegionName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;--,b.[Name] AS BranchName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (b.[Name],' (',b.[Id],')') AS BranchName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (m.NickName,' (',m.PassbookNumber,')') AS BorrowerName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,m.PassbookNumber AS PassbookNumber_int&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (m.NID, CASE WHEN (m.SmartNID IS NOT NULL OR m.SmartNID &lt;&gt; ' ') AND (m.NID IS NOT NULL OR m.NID &lt;&gt; ' ') THEN ' / ' END , m.SmartNID) AS [National Id /Smart Id_string]&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(m.MobileNo, '') AS MobileNumber_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(m.BirthRegistrationNumber, '') AS BirthRegistrationNumber_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,m.GuardianName AS GuardianName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,G.[Name] AS GroupName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,md.[Name] AS MeetingDay_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,p.[Name] AS ProductName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (EMP.[Name],' (',EMP.Code,')') AS LoanOfficer_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.LoanCycle AS Cycle_int&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,f.[Name] AS Fund_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,s.[Name] AS Scheme_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,i.Frequency AS InstallmentType_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(tmpOth.Debit, 0) + ISNULL(tmpOth.Credit, 0) AS LSRFAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;--,ISNULL(la.LSRFAmount,0) AS LSRFAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(fc.[Name], '') LSRFType_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.DisburseDate AS LoanDisbursed_DisbursementDate_intdate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.FirstInstallmentDate AS LoanDisbursed_FirstInstallmentDate_intdate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,DATEDIFF(day, [migration].[Func_GetBigintToDate](la.DisburseDate)&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,[migration].[Func_GetBigintToDate](la.FirstInstallmentDate)) AS LoanDisbursed_GracePeriodInDays_int&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.PrincipalAmount AS LoanDisbursed_PrincipalAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.DisburseAmount AS LoanDisbursed_DisbursedAmountWithServiceCharge_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_PreviousDisburseAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_PreviousFullpaidDate_intdate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_PreviousLoanLastPaidAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_LoanIncrementAmount_double&#x0D;&#x0A;&#x0D;&#x0A;&#x09;&#x09;&#x09;INTO #RESULTSET_BY_MEMBER&#x0D;&#x0A;&#x09;&#x09;&#x09;FROM #TMP_LOAN_ACC AS la &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Member AS m WITH (NOLOCK) ON la.MemberId = m.Id&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN #LOAN_HIST AS ph ON la.MemberId = ph.MemberId AND la.id = ph.Id  &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN #GRP_INFO AS G ON G.loan_id = la.Id&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN [hrm].[Employee] EMP ON EMP.Id = g.ProgramOfficerId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Fund AS f ON f.Id = la.FundId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Scheme AS s ON s.Id = la.SchemeId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Product AS p ON p.Id = la.ProductId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.InstallmentFrequency AS i ON i.Id = la.InstallmentFrequencyId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN #TMP_OTHER AS tmpOth ON la.Id = tmpOth.AccountId AND tmpOth.TransactionTypeId = 47&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN program.FeeLoanAccountWithDetails AS fl WITH (NOLOCK) ON fl.AccountId = la.Id&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN program.Fee AS fee on fl.FeeId = fee.Id AND fee.ChargeType = 1 &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN (SELECT [Name], [Value] FROM program.FeeConfig WHERE [Type] = 'PolicyType') AS fc ON fc.[Value] = fl.PolicyId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.Branch AS b ON b.Id = la.OriginatingBranchId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.BranchRegion AS br ON br.BranchId = b.Id AND br.StartDate &lt;= @startDate AND ISNULL(br.EndDate, 20991231000000) &gt;= @endDate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.Region AS r ON r.Id = br.RegionId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.RegionDistrict AS rd ON rd.RegionId = r.Id AND rd.StartDate &lt;= @startDate AND ISNULL(rd.EndDate, 20991231000000) &gt;= @endDate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.District AS d ON d.Id = rd.DistrictId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.DistrictZone AS dz ON dz.DistrictId = d.Id&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.[Zone] AS z ON z.Id = dz.ZoneId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.MeetingDay AS md ON md.[Value] = m.MeetingDayId&#x0D;&#x0A;&#x09;&#x09;&#x09;WHERE &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;b.Id = @branchId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND (@loanType = - 1 OR p.ProductId = @loanType)&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND (@loanOfficer = - 1 OR EMP.Id = @loanOfficer )&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND (@groupId = - 1 OR G.GroupId = @groupId)&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND m.Id = @memberId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND (@meetingDayId = - 1 OR m.MeetingDayId = @meetingDayId)&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x0D;&#x0A;&#x09;&#x09;&#x09;ORDER BY la.DisburseDate" StatementId="16" StatementCompId="20" StatementType="SELECT INTO" StatementSqlHandle="0x090066B0C55D4439692977D787A9118B666A0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1068582895" BatchSqlHandle="0x03000600EF47B13F8E68070170B4000001000000000000000000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.175414" StatementEstRows="1.33015" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x4FDF443DF6E052A6" QueryPlanHash="0xF7B78DBCD8963CF5" StatementOptmEarlyA