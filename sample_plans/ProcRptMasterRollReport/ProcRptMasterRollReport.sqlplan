ence Column="Expr1008"/></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="(1)"/></ScalarOperator></Compare></ScalarOperator></Predicate></Filter></RelOp></Update></RelOp></QueryPlan></StmtSimple><StmtSimple StatementText="&#x0D;&#x0A;&#x0D;&#x0A;&#x09;SELECT &#x0D;&#x0A;&#x09;&#x09;LH.Id,&#x0D;&#x0A;&#x09;&#x09;LH.MemberId,&#x0D;&#x0A;&#x09;&#x09;LH.PreviousAccountId,&#x0D;&#x0A;&#x09;&#x09;LH.LoanDisbursed_PreviousDisburseAmount_double,&#x0D;&#x0A;&#x09;&#x09;LH.LoanDisbursed_PreviousFullpaidDate_intdate,&#x0D;&#x0A;&#x09;&#x09;LH.LoanDisbursed_LoanIncrementAmount_double,&#x0D;&#x0A;&#x09;&#x09;LP.PaidTotalAmount AS LoanDisbursed_PreviousLoanLastPaidAmount_double&#x0D;&#x0A;&#x09;INTO #LOAN_HIST&#x0D;&#x0A;&#x09;FROM #LOAN_HIST_TMP LH&#x0D;&#x0A;&#x09;LEFT JOIN #LAST_LOAN_PAID LP ON LP.LoanAccountId = LH.PreviousAccountId" StatementId="13" StatementCompId="15" StatementType="SELECT INTO" StatementSqlHandle="0x0900E55309A4A76E0E2288CAFDE32B01388C0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1068582895" BatchSqlHandle="0x03000600EF47B13F8E68070170B4000001000000000000000000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0791727" StatementEstRows="600" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x576F698C2A4F2D6F" QueryPlanHash="0xBEF7F34C38C97B3C" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="70"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan NonParallelPlanReason="MaxDOPSetToOne" CachedPlanSize="88" CompileTime="4" CompileCPU="4" CompileMemory="360"><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="1216" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryG