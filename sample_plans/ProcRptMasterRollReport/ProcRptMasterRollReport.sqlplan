 EstimateRows="600" EstimatedRowsRead="600" EstimateIO="0.00608796" EstimateCPU="0.000817" AvgRowSize="51" EstimatedTotalSubtreeCost="0.00690496" TableCardinality="600" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="MemberId"/><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="Id"/><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="PreviousAccountId"/><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="LoanDisbursed_PreviousDisburseAmount_double"/><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="LoanDisbursed_PreviousFullpaidDate_intdate"/><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="LoanDisbursed_LoanIncrementAmount_double"/></OutputList><TableScan Ordered="0" ForcedIndex="0" ForceScan="0" NoExpandHint="0" Storage="RowStore"><DefinedValues><DefinedValue><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="MemberId"/></DefinedValue><DefinedValue><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="Id"/></DefinedValue><DefinedValue><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="PreviousAccountId"/></DefinedValue><DefinedValue><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="LoanDisbursed_PreviousDisburseAmount_double"/></DefinedValue><DefinedValue><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="LoanDisbursed_PreviousFullpaidDate_intdate"/></DefinedValue><DefinedValue><ColumnReference Table="#LOAN_HIST_TMP" Alias="[LH]" Column="LoanDisbursed_LoanIncrementAmount_double"/></DefinedValue></DefinedValues><Object Database="[tempdb]" Schema="[dbo]" Table="[#LOAN_HIST_TMP]" Alias="[LH]" Storage="RowStore"/></TableScan></RelOp></Hash></RelOp></Update></RelOp></QueryPlan></StmtSimple><StmtCond StatementText="&#x0D;&#x0A;&#x0D;&#x0A;&#x09;-- =============================== Get ALL Resultset =============================&#x0D;&#x0A;&#x09;IF(@memberId=-1)" StatementId="14" StatementCompId="16" StatementType="COND" RetrievedFromCache="true"><Condition/><Then><Statements><StmtSimple StatementText="&#x0D;&#x0A;&#x09;&#x09;BEGIN&#x0D;&#x0A;&#x09;&#x09;&#x09;SELECT DISTINCT &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;z.[Name] AS DivisionName_string,&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;d.[Name] AS DistrictName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,r.[Name] AS RegionName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;--,b.[Name] AS BranchName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (b.[Name],' (',b.[Id],')') AS BranchName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (m.NickName,' (',m.PassbookNumber,')') AS BorrowerName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,m.PassbookNumber AS PassbookNumber_int&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (m.NID, CASE WHEN (m.SmartNID IS NOT NULL OR m.SmartNID &lt;&gt; ' ') AND (m.NID IS NOT NULL OR m.NID &lt;&gt; ' ') THEN ' / ' END , m.SmartNID) AS [National Id /Smart Id_string]&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(m.MobileNo, '') AS MobileNumber_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(m.BirthRegistrationNumber, '') AS BirthRegistrationNumber_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,m.GuardianName AS GuardianName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,G.[Name] AS GroupName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,md.[Name] AS MeetingDay_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,p.[Name] AS ProductName_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,CONCAT (EMP.[Name],' (',EMP.Code,')') AS LoanOfficer_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.LoanCycle AS Cycle_int&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,f.[Name] AS Fund_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,s.[Name] AS Scheme_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,i.Frequency AS InstallmentType_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(tmpOth.Debit, 0) + ISNULL(tmpOth.Credit, 0) AS LSRFAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ISNULL(fc.[Name], '') LSRFType_string&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.DisburseDate AS LoanDisbursed_DisbursementDate_intdate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.FirstInstallmentDate AS LoanDisbursed_FirstInstallmentDate_intdate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,DATEDIFF(day, [migration].[Func_GetBigintToDate](la.DisburseDate) &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,[migration].[Func_GetBigintToDate](la.FirstInstallmentDate)) AS LoanDisbursed_GracePeriodInDays_int&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.PrincipalAmount AS LoanDisbursed_PrincipalAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,la.DisburseAmount AS LoanDisbursed_DisbursedAmountWithServiceCharge_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_PreviousDisburseAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_PreviousFullpaidDate_intdate&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_PreviousLoanLastPaidAmount_double&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;,ph.LoanDisbursed_LoanIncrementAmount_double&#x0D;&#x0A;&#x0D;&#x0A;&#x09;&#x09;&#x09;INTO #RESULTSET_ALL&#x0D;&#x0A;&#x09;&#x09;&#x09;FROM #TMP_LOAN_ACC AS la&#x09;&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Member AS m WITH (NOLOCK) ON la.MemberId = m.Id&#x09;&#x09;&#x09;&#x09;&#x09;&#x09;&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.Branch AS b ON b.Id = la.OriginatingBranchId&#x09;&#x09;&#x09;&#x09;&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Fund AS f ON f.Id = la.FundId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Scheme AS s ON s.Id = la.SchemeId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.Product AS p ON p.Id = la.ProductId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.InstallmentFrequency AS i ON i.Id = la.InstallmentFrequencyId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.BranchRegion AS br ON br.BranchId = b.Id AND (la.DisburseDate BETWEEN br.StartDate AND ISNULL(br.EndDate, 20991231000000))&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.Region AS r ON r.Id = br.RegionId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.RegionDistrict AS rd ON rd.RegionId = r.Id AND (la.DisburseDate BETWEEN rd.StartDate AND ISNULL(rd.EndDate, 20991231000000))&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.District AS d ON d.Id = rd.DistrictId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.DistrictZone AS dz ON dz.DistrictId = d.Id  AND (la.DisburseDate BETWEEN dz.StartDate AND ISNULL(dz.EndDate, 20991231000000))&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN dbo.[Zone] AS z ON z.Id = dz.ZoneId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;INNER JOIN program.MeetingDay AS md ON md.Value = m.MeetingDayId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN #LOAN_HIST AS ph ON ph.MemberId = la.MemberId AND ph.Id = la.Id&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN #GRP_INFO AS G ON G.loan_id = la.Id&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN [hrm].[Employee] EMP ON EMP.Id = g.ProgramOfficerId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN #TMP_OTHER AS tmpOth ON la.Id = tmpOth.AccountId AND tmpOth.TransactionTypeId = 47&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN program.FeeLoanAccountWithDetails AS fl WITH (nolock) ON fl.AccountId = la.Id &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;JOIN program.Fee AS fee on fl.FeeId = fee.Id AND fee.ChargeType = 1 &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;LEFT JOIN (SELECT [Name], [Value] FROM program.FeeConfig WHERE [Type] = 'PolicyType') AS fc ON fc.[Value] = fl.PolicyId&#x09;&#x09;&#x09;&#x09;&#x0D;&#x0A;&#x09;&#x09;&#x09;WHERE &#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;b.Id = @branchId&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND ( @loanType = - 1 OR p.ProductId = @loanType )&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND (@loanOfficer = - 1 OR EMP.Id = @loanOfficer )&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND (@groupId = - 1 OR G.GroupId = @groupId )&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x09;AND ( @meetingDayId = - 1 OR m.MeetingDayId = @meetingDayId )&#x0D;&#x0A;&#x09;&#x09;&#x09;&#x0D;&#x0A;&#x09;&#x09;&#x09;ORDER BY la.DisburseDate" StatementId="15" StatementCompId="17" StatementType="SELECT INTO" Statem