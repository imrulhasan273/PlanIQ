D;&#x0A;&#x09;CREATE NONCLUSTERED INDEX #INDX_TMP_LOAN_ACC_MemberId ON #TMP_LOAN_ACC (MemberId)" StatementId="4" StatementCompId="6" StatementType="CREATE INDEX" RetrievedFromCache="true"/><StmtSimple StatementText=";&#x0D;&#x0A;&#x0D;&#x0A;&#x09;-- =============================== Find Group Information ==============================&#x0D;&#x0A;&#x09;SELECT &#x0D;&#x0A;&#x09;&#x09;DISTINCT MM.MemberId AS MemId, &#x0D;&#x0A;&#x09;&#x09;MM.GroupId,&#x0D;&#x0A;&#x09;&#x09;g.[Name], &#x0D;&#x0A;&#x09;&#x09;--g.MeetingDayId, &#x0D;&#x0A;&#x09;&#x09;MM.ProgramOfficerId,&#x0D;&#x0A;&#x09;&#x09;la.Id loan_id&#x0D;&#x0A;&#x09;INTO #GRP_INFO&#x0D;&#x0A;&#x09;FROM program.MemberMoveHistory MM WITH (NOLOCK) &#x0D;&#x0A;&#x09;INNER JOIN #TMP_LOAN_ACC AS LA ON LA.MemberId = MM.MemberId &#x0D;&#x0A;&#x09;INNER JOIN program.[Group] g ON g.Id = MM.GroupId&#x0D;&#x0A;&#x09;WHERE MM.StartDate &lt;= LA.[DisburseDate]&#x0D;&#x0A;&#x09;AND (MM.EndDate IS NULL OR MM.EndDate &gt;= LA.[DisburseDate])" StatementId="5" StatementCompId="7" StatementType="SELECT INTO" StatementSqlHandle="0x09001D30CA5D9DDC0F7E868A3FD28B43454B0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1068582895" BatchSqlHandle="0x03000600EF47B13F8E68070170B4000001000000000000000000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="6.5261" StatementEstRows="436.359" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xA1ADD6EFE5BBD9C6" QueryPlanHash="0xB3EFA3F0E2B40912" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="70"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan NonParallelPlanReason="MaxDOPSetToOne" CachedPlanSize="616" CompileTime="93" CompileCPU="93" CompileMemory="15192"><MemoryGrantInfo SerialRequiredMemory="